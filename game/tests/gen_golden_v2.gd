extends Node
## Writes tests/golden/sim_v2_vectors.json from GoldenV2 (run by hand: godot --headless res://tests/gen_golden_v2.tscn).

func _ready() -> void:
	var out: Array = []
	for c in GoldenV2.cases():
		out.append({"case": c, "expect": GoldenV2.run_case(c)})
	var f := FileAccess.open("res://tests/golden/sim_v2_vectors.json", FileAccess.WRITE)
	f.store_string(JSON.stringify({"schema": "gloamline/sim-v2-golden", "version": 1, "note": "Generated by tests/gen_golden_v2.tscn; see tests/golden_v2.gd.", "cases": out}, " "))
	print("wrote %d cases" % out.size())
	get_tree().quit()
