{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Club (Phase 1 league)",
  "type": "object",
  "required": ["id", "name", "strength_offset", "country", "player_ids"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "placeholder": {"type": "boolean"},
    "strength_offset": {"type": "number", "minimum": -4, "maximum": 4},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "player_ids": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}}
  }
}
